FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object HFDIBDEMDict;
}

bodyNames ("icoSphere");
interpolationSchemes { U cell; }
surfaceThreshold 1e-6;
nDragForceSmoothingIterations 0;
nDirectForcingIterations 1;
immersedUTolerance 1e-4;
stepDEM 1;
geometricD (1 1 1);
recordSimulation false;
recordFirstTimeStep false;
nSolidsInDomain -1;
virtualMesh { level 1; charCellSize 0.25; }
outputSetup { basic false; iB false; DEM false; addModel false; parallelDEM false; }
DEM
{
    LcCoeff 0.55;
    materials
    {
        particle { Y 1e7; nu 0.3; mu 0; adhN 0; eps 1; }
        wall { Y 1e7; nu 0.2; mu 0; adhN 0; eps 1; }
    }
    collisionPatches
    {
        walls
        {
            material wall;
            nVec (0 -1 0);
            planePoint (0 0 0);
        }
    }
}
icoSphere
{
    fullyCoupledBody;
    rho rho [1 -3 0 0 0 0 0] 3200;
    U { BC noSlip; }
    material particle;
    bodyGeom sphere;
    sphere { radius 0.45; startPosition (1.3 0.8 1); }
    updateTorque false;
    sdBasedLambda false;
    interfaceSpan 1.0;
    startSynced false;
    refineBuffers -1;
    timesToSetStatic -1;
    bodyAddition { addModel once; onceCoeffs {} }
}
