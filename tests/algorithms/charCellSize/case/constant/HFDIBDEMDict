FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      HFDIBDEMDict;
}

bodyNames       (sphere);

interpolationSchemes
{
    U           cell;
}

surfaceThreshold 1e-4;
adaptiveStepDEM false;
stepDEM         1;
geometricD      (1 1 1);
recordSimulation false;
recordFirstTimeStep false;

outputSetup
{
    basic       true;
    iB          true;
    DEM         true;
    addModel    false;
    parallelDEM false;
}

DEM
{
    LcCoeff     0.55;
    materials
    {
        particle
        {
            Y       1e7;
            nu      0.3;
            mu      0;
            adhN    0;
            eps     1;
        }
        wall
        {
            $particle;
        }
    }
    collisionPatches {}
}

virtualMesh
{
    level       2;
    charCellSize 0.005;
    exactSubVolume true;
    maxSubVolumes 1000000;
}

sphere
{
    fullyCoupledBody;
    rho         rho [1 -3 0 0 0 0 0] 2500;
    material    particle;
    bodyGeom    sphere;
    sphere
    {
        radius      0.025;
        startPosition (0.05 0.07 0);
    }
    U
    {
        BC          noSlip;
    }
    bodyAddition
    {
        addModel    once;
        onceCoeffs  {}
    }
    updateTorque true;
    sdBasedLambda false;
    interfaceSpan 1.0;
    startSynced false;
    refineBuffers 0;
    timesToSetStatic -1;
}
