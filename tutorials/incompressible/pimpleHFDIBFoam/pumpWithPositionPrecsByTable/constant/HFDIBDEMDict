rectangle_000
{
    prescribedPosTableBody
    {
        axis     (0 0 -1);
        velocity (0 0 0);
        omega    0;
        posIntTableDict
        {
            file "$FOAM_CASE/constant/posIntTables/rectangle_000";
        }
    }
    rho         rho [1 -3 0 0 0 0 0] 3950;
    U
    {
    	BC  noSlip;
    }
    material particle;
    bodyGeom convex;
    updateTorque false;
    sdBasedLambda false;
    overlayLambda max;
    interfaceSpan 1.0;
    startSynced false;
    refineBuffers 2;
    timesToSetStatic -1;
    bodyAddition
    {
    	addModel once;
    	distributionCoeffs
    	{
    		addMode fieldBased;
            stlBaseSize        1e-5;
    		fieldBasedCoeffs
    		{
    			fieldName lambda;
    			fieldValue 0.05;
    		}
    	}
    }
}

